# LLM Settings
LLM_PROVIDER=ollama
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:0.5b

# Airflow & Spark Targets


SPARK_HISTORY_API=http://spark-history:18080/api/v1/applications
SPARK_WORKER_LOG_DIR=/opt/spark-worker-logs
SPARK_HISTORY_TIMEOUT=30 


# Airflow
AIRFLOW_BASE=http://localhost:8080/api/v1
#AIRFLOW_TOKEN=your_airflow_token_here
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=your_airflow_password_here

# Spark History
SPARK_HISTORY_BASE=http://localhost:18080/api/v1

# S3 event logs path (fallback). Example: s3a://my-bucket/spark-event-logs
SPARK_EVENT_LOGS_PATH=s3a://sarang-de/spark-event-logs

AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

ATHENA_DB=gluedb
ATHENA_OUTPUT=s3://sarang-de/athena-query-results/

# Logging
LOG_LEVEL=INFO
#LOG_TO_FILE=/var/log/rca-agent.log
#LOG_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s



DB_HOST=localhost
DB_PORT=5432
DB_NAME=metadata
DB_USER=postgres
DB_PASSWORD=your_db_password_here
